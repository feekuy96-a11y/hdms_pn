{
  "name": "doh-pattani-flood",
  "version": "2.0.0",
  "description": "ระบบแผนที่รายงานสถานการณ์น้ำท่วมและเส้นทางเลี่ยง แขวงทางหลวงปัตตานี กรมทางหลวง",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:server": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:fast": "tsc --noEmit",
    "test:e2e": "playwright test",
