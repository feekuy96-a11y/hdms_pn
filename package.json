    "@types/jszip": "^3.4.1",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "9.39.5",
